{
  "openapi": "3.0.3",
  "info": {
    "title": "TaskFlow API",
    "version": "1.2.0",
    "description": "API de gestion de tâches personnelles (TP Full Stack JS, EFREI M1). Toutes les routes sont préfixées par /api. Les routes /api/tasks exigent un JWT transmis dans l'en-tête Authorization: Bearer <token>. Chaque compte ne voit que ses propres tâches. Bonus B1 : champ priority, filtres de liste (status, priority, due, today) et compteurs (/tasks/stats). Bonus B4 : champ serveur completedAt et statistiques hebdomadaires (/tasks/stats/weekly)."
  },
  "servers": [
    { "url": "http://localhost:3000/api", "description": "Développement local" }
  ],
  "tags": [
    { "name": "Santé", "description": "Supervision" },
    { "name": "Authentification", "description": "Inscription et connexion (routes publiques)" },
    { "name": "Tâches", "description": "CRUD des tâches du compte connecté (JWT requis)" },
    { "name": "Bonus B1", "description": "Priorité, filtres et compteurs (routes additionnelles, le CRUD de base reste inchangé)" },
    { "name": "Bonus B4", "description": "Statistiques hebdomadaires : taux de complétion et évolution par semaine" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT signé HS256, obtenu via /auth/register ou /auth/login. Expire après JWT_EXPIRES_IN (1h par défaut)."
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "additionalProperties": false,
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alice@example.test", "description": "Comparé et stocké en minuscules." },
          "password": { "type": "string", "minLength": 8, "maxLength": 72, "example": "MotDePasse123!" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "66f2a1c9e4b0a2d3f4e5b6c7" },
          "email": { "type": "string", "format": "email", "example": "alice@example.test" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "token": { "type": "string", "description": "JWT signé", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2NmYyYTFjOWU0YjBhMmQzZjRlNWI2YzciLCJpYXQiOjE3Mjc2ODAwMDAsImV4cCI6MTcyNzY4MzYwMH0.signature" }
        }
      },
      "TaskStatus": {
        "type": "string",
        "enum": ["todo", "doing", "done"]
      },
      "TaskPriority": {
        "type": "string",
        "enum": ["low", "medium", "high"],
        "description": "Bonus B1. Facultatif à la création (medium par défaut)."
      },
      "TaskCreate": {
        "type": "object",
        "required": ["title", "status"],
        "additionalProperties": false,
        "description": "Les champs id et ownerId sont refusés (400). Toute propriété inconnue est refusée (400).",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Trimé côté serveur ; vide après trim refusé.", "example": "Préparer la démo" },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/TaskPriority" },
          "description": { "type": "string", "maxLength": 1000, "default": "", "example": "Plan et données" },
          "dueDate": { "type": "string", "nullable": true, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date civile réelle YYYY-MM-DD ou null. 2026-02-30 est refusé.", "example": "2026-10-05" }
        }
      },
      "TaskPatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "description": "Partiel et non vide. Mêmes règles de validation que la création ; id et ownerId refusés (400).",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/TaskPriority" },
          "description": { "type": "string", "maxLength": 1000 },
          "dueDate": { "type": "string", "nullable": true, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "title": { "type": "string", "example": "Préparer la démo" },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "priority": { "$ref": "#/components/schemas/TaskPriority" },
          "description": { "type": "string", "example": "Plan et données" },
          "dueDate": { "type": "string", "nullable": true, "example": "2026-10-05" },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true, "description": "Bonus B4. Posé par le serveur au passage à done, remis à null si la tâche est rouverte. Jamais accepté dans un corps de requête (400)." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }
        }
      },
      "TaskStats": {
        "type": "object",
        "description": "Compteurs du compte connecté (bonus B1).",
        "properties": {
          "total": { "type": "integer", "example": 5 },
          "byStatus": {
            "type": "object",
            "properties": {
              "todo": { "type": "integer", "example": 3 },
              "doing": { "type": "integer", "example": 1 },
              "done": { "type": "integer", "example": 1 }
            }
          },
          "byPriority": {
            "type": "object",
            "properties": {
              "low": { "type": "integer", "example": 2 },
              "medium": { "type": "integer", "example": 2 },
              "high": { "type": "integer", "example": 1 }
            }
          },
          "overdue": { "type": "integer", "description": "Échéance antérieure à la date de référence et statut différent de done.", "example": 1 }
        }
      },
      "WeeklyStats": {
        "type": "object",
        "description": "Bonus B4. Semaines ISO (lundi → dimanche), la dernière contenant la date de référence. created = tâches créées pendant la semaine ; completed = tâches passées à done pendant la semaine ; open = tâches créées au plus tard le dernier jour de la semaine et non terminées avant son premier jour ; completionRate = completed / open (null si open = 0). Les instants sont rattachés à une date civile selon tzOffset.",
        "properties": {
          "weeks": { "type": "integer", "example": 8 },
          "today": { "type": "string", "example": "2026-10-07" },
          "tzOffset": { "type": "integer", "example": -120 },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "weekStart": { "type": "string", "example": "2026-10-05" },
                "weekEnd": { "type": "string", "example": "2026-10-11" },
                "created": { "type": "integer", "example": 2 },
                "completed": { "type": "integer", "example": 1 },
                "open": { "type": "integer", "example": 3 },
                "completionRate": { "type": "number", "nullable": true, "example": 0.3333 }
              }
            }
          },
          "overall": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "example": 5 },
              "done": { "type": "integer", "example": 3 },
              "completionRate": { "type": "number", "nullable": true, "example": 0.6 }
            }
          },
          "trend": {
            "type": "object",
            "description": "Évolution entre la semaine précédente et la semaine courante.",
            "properties": {
              "currentRate": { "type": "number", "nullable": true, "example": 0.3333 },
              "previousRate": { "type": "number", "nullable": true, "example": 0.5 },
              "delta": { "type": "number", "nullable": true, "example": -0.1667 }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "enum": ["INVALID_INPUT", "UNAUTHORIZED", "NOT_FOUND", "EMAIL_ALREADY_USED", "INTERNAL_ERROR"] },
              "message": { "type": "string", "example": "Message lisible" }
            }
          }
        }
      }
    },
    "responses": {
      "InvalidInput": {
        "description": "Corps invalide, champ hors règles, paramètre de requête inconnu ou identifiant malformé",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "INVALID_INPUT", "message": "Le statut doit valoir todo, doing, done" } } } }
      },
      "Unauthorized": {
        "description": "JWT absent, invalide, falsifié ou expiré ; ou identifiants de connexion incorrects",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "UNAUTHORIZED", "message": "Jeton invalide ou expiré" } } } }
      },
      "NotFound": {
        "description": "Tâche inexistante ou appartenant à un autre compte",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "NOT_FOUND", "message": "Tâche introuvable" } } } }
      },
      "EmailAlreadyUsed": {
        "description": "Email déjà enregistré",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "EMAIL_ALREADY_USED", "message": "Cet email est déjà utilisé" } } } }
      }
    },
    "parameters": {
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ObjectId MongoDB (24 caractères hexadécimaux)",
        "schema": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
        "example": "507f1f77bcf86cd799439011"
      },
      "TodayQuery": {
        "name": "today",
        "in": "query",
        "required": false,
        "description": "Date de référence YYYY-MM-DD pour overdue / today / upcoming et le compteur overdue (par défaut : date UTC du serveur). Permet au navigateur d'envoyer sa date locale.",
        "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "example": "2026-10-07"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Santé"],
        "summary": "Vérifie que l'API répond",
        "responses": {
          "200": {
            "description": "API opérationnelle",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "enum": ["ok"] } } }, "example": { "status": "ok" } } }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentification"],
        "summary": "Crée un compte et renvoie un JWT",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
        "responses": {
          "201": { "description": "Compte créé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "409": { "$ref": "#/components/responses/EmailAlreadyUsed" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentification"],
        "summary": "Connecte un utilisateur et renvoie un JWT",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
        "responses": {
          "200": { "description": "Connexion réussie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tâches"],
        "summary": "Liste les tâches du compte connecté",
        "description": "Sans paramètre : toutes les tâches du compte. Bonus B1 : filtres facultatifs combinables. Un paramètre inconnu ou une valeur hors liste donne 400.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/TaskStatus" } },
          { "name": "priority", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/TaskPriority" } },
          {
            "name": "due",
            "in": "query",
            "required": false,
            "description": "overdue : échéance passée et statut différent de done ; today : échéance égale à la date de référence ; upcoming : échéance supérieure ou égale ; none : sans échéance.",
            "schema": { "type": "string", "enum": ["overdue", "today", "upcoming", "none"] }
          },
          { "$ref": "#/components/parameters/TodayQuery" }
        ],
        "responses": {
          "200": { "description": "Liste (éventuellement vide : {\"items\":[]})", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskList" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Tâches"],
        "summary": "Crée une tâche pour le compte connecté",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskCreate" } } } },
        "responses": {
          "201": { "description": "Tâche créée", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks/stats": {
      "get": {
        "tags": ["Bonus B1"],
        "summary": "Compteurs des tâches du compte connecté",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TodayQuery" }],
        "responses": {
          "200": { "description": "Compteurs", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskStats" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks/stats/weekly": {
      "get": {
        "tags": ["Bonus B4"],
        "summary": "Taux de complétion hebdomadaire et évolution par semaine",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "weeks", "in": "query", "required": false, "description": "Nombre de semaines renvoyées, de 1 à 26 (8 par défaut).", "schema": { "type": "integer", "minimum": 1, "maximum": 26, "default": 8 } },
          { "$ref": "#/components/parameters/TodayQuery" },
          { "name": "tzOffset", "in": "query", "required": false, "description": "Décalage du client en minutes, convention JavaScript getTimezoneOffset (UTC − locale, Paris en été = -120). Par défaut 0 : dates lues en UTC.", "schema": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Séries hebdomadaires", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeeklyStats" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
      "get": {
        "tags": ["Tâches"],
        "summary": "Consulte une tâche",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Tâche", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tâches"],
        "summary": "Modifie partiellement une tâche",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskPatch" }, "example": { "status": "done" } } } },
        "responses": {
          "200": { "description": "Tâche modifiée", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tâches"],
        "summary": "Supprime une tâche",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Supprimée, aucun corps" },
          "400": { "$ref": "#/components/responses/InvalidInput" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
