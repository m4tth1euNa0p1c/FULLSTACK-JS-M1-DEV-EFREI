# Port HTTP de l'API
PORT=3000

# Chaîne de connexion MongoDB (base de développement)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Clé de signature des JWT : longue chaîne aléatoire, JAMAIS versionnée.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Durée de vie d'un jeton (format de la librairie jsonwebtoken : 15m, 1h, 7d...)
JWT_EXPIRES_IN=1h

# Coût du hachage bcrypt (10 est un bon compromis sécurité/temps)
BCRYPT_ROUNDS=10

# Origine autorisée pour les requêtes du navigateur (adresse du front Vite)
CORS_ORIGIN=http://localhost:5173
