# URL de base de l'API (sans le suffixe /api).
# Laisser vide en développement : Vite relaie /api vers http://localhost:3000 (voir vite.config.js).
# Renseigner uniquement si le front construit est servi depuis une autre origine que l'API.
VITE_API_URL=

# Facultatif, pour les démonstrations : préremplit le formulaire de connexion.
# Laisser vide (ou absent) partout ailleurs qu'en local. Le compte ci-dessous est celui
# créé par `node scripts/recette.js`.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
